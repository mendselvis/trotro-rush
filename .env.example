# Supabase project (Settings > API). No tables needed, only Realtime broadcast.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Claude API for passenger missions and the trip report.
# Without it the game uses built-in missions and a template report.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
